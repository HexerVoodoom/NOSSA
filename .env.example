# Supabase — OPCIONAL.
#
# Sem estas variáveis, o app roda só com dados locais no navegador e sem login
# (é como ele funciona hoje). Preenchendo as duas, o app passa a exigir login e
# a compartilhar os dados entre todo mundo pelo banco.
#
# Onde achar: painel do Supabase -> Project Settings -> API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = a chave publicável ("anon public" / "publishable")
#
# A anon key é pública por natureza (vai no navegador). A proteção real vem das
# políticas de RLS em supabase/schema.sql, que só liberam dados para usuários
# autenticados. NUNCA coloque aqui a "service_role key".

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
